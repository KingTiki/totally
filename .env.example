# Required: generate PASSWORD_HASH and SESSION_SECRET using the setup script.
# Keep this file private once filled in; never commit credentials.
PASSWORD_HASH=
SESSION_SECRET=
ORIGIN=http://localhost:3000
# Only when running without Docker. Compose fixes these values inside the container.
HOST=0.0.0.0
PORT=3000
DATA_DIR=./data
# Optional Docker Compose host address and port.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
# Maximum HTTP request size, including uploads.
BODY_SIZE_LIMIT=110M
# Optional: HTTPS automatically uses secure cookies. Never set false for HTTPS.
COOKIE_SECURE=
# Optional existing SMTP account. Host, sender and recipient are required for email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
