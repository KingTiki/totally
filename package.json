{
  "name": "totally",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*.svelte": "./src/lib/*.svelte",
    "#lib/*.css": "./src/lib/*.css",
    "#lib/*": "./src/lib/*.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3000 --strictPort",
    "build": "vite build && node scripts/collect-licenses.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project src/service-worker/tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:container": "node scripts/container-smoke.mjs",
    "format": "prettier --write .github src tests scripts docs server.mjs playwright.config.ts vite.config.ts tsconfig.json package.json compose.yaml *.md static/brand/*.md static/fonts/*.md",
    "docs:screenshot": "node scripts/readme-screenshot.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "nodemailer": "^10.2.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/web-push": "^3.6.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "^8.3.5"
  }
}
